POSTGRES_DB=pengka_material
POSTGRES_USER=pengka
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://pengka:CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD@db:5432/pengka_material
ENVIRONMENT=production
COOKIE_SECURE=false
SESSION_HOURS=8
ATTACHMENT_DIR=/storage/attachments
MAX_UPLOAD_MB=20
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
BUSINESS_TIMEZONE=Asia/Shanghai
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=系统管理员
# ADMIN_PASSWORD 不建议长期写入 .env；创建管理员时交互输入更安全。
