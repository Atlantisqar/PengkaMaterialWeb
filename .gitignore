frontend/vite.config.js
frontend/vite.config.d.ts

# Runtime data: keep only directory placeholders
storage/attachments/*
storage/imports/*
storage/exports/*
storage/backups/*
storage/*.log
!storage/**/.gitkeep

# Editors and operating-system metadata
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
