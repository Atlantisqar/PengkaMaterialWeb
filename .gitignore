.env
.env.*
!.env.example

# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
backend/.venv/
backend/*.db
backend/.coverage
coverage.xml
htmlcov/

# Frontend dependencies and generated output
